{
  "name": "@trellix/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-editor.mjs && NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "node scripts/build-editor.mjs && NODE_ENV=development node hmr.ts",
    "start": "node scripts/build-editor.mjs && NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "node scripts/build-editor.mjs && NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "cf:dev": "cf dev",
    "cf:deploy": "cf deploy",
    "build:editor": "node scripts/build-editor.mjs"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@37signals/lexxy": "1.0.1",
    "@rails/activestorage": "^8.1.400",
    "@remix-run/ui": "0.12.1",
    "@trellix/contracts": "workspace:*",
    "@trellix/data": "workspace:*",
    "@trellix/session": "workspace:*",
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-c82c3efb3",
    "@types/node": "latest",
    "cf": "1.0.0-beta.17",
    "typescript": "latest",
    "vite": "^8.3.4"
  }
}
